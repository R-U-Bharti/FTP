# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# NOTE: /android is intentionally committed — it holds hand-customized native
# code (custom AndroidManifest, the localdrop-server native module). EAS uses
# the committed folder directly and skips prebuild. Build artifacts are still
# excluded via android/.gitignore.
/ios

# local expo module build outputs
modules/*/android/build/
modules/*/ios/build/

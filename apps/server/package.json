{
  "name": "@localdrop/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": "build/server.cjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:exe": "node scripts/build-exe.mjs",
    "clean": "rm -rf dist build release"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "@localdrop/shared-types": "workspace:*",
    "express": "^5.1.0",
    "socket.io": "^4.8.0",
    "cors": "^2.8.5",
    "busboy": "^1.6.0",
    "mime-types": "^3.0.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "@yao-pkg/pkg": "^6.3.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^2.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0"
  }
}
